{
  "name": "live2d-desktop-mascot",
  "version": "1.4.0",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "postinstall": "node scripts/copy-three-addons.js"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "adm-zip": "^0.6.1",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.9",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fixtan/live2d-desktop-mascot.git"
  },
  "homepage": "https://github.com/fixtan/live2d-desktop-mascot",
  "productName": "Live2D Desktop Mascot",
  "description": "VS Code の枠内に常駐する Live2D / VRM デスクトップマスコット",
  "author": "lain",
  "license": "MIT",
  "build": {
    "appId": "com.fixtan.live2d-desktop-mascot",
    "productName": "Live2D Desktop Mascot",
    "files": [
      "src/**/*",
      "assets/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "live2d-desktop-mascot-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "live2d-desktop-mascot-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "artifactName": "live2d-desktop-mascot-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "lain",
      "artifactName": "live2d-desktop-mascot-${version}-linux-${arch}.${ext}"
    }
  }
}
